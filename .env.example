# Lokal: pakai file SQLite biasa. Produksi: URL Turso (libsql://nama-db-org.turso.io)
ST_BLOG_DB_TURSO_DATABASE_URL=file:local.db
# Kosongkan untuk database lokal. Produksi: turso db tokens create <nama-db>
ST_BLOG_DB_TURSO_AUTH_TOKEN=

# Alamat blog ini (dipakai untuk canonical URL)
SITE_URL=http://localhost:4321

# Akun dengan email di daftar ini otomatis menjadi admin (pisahkan dengan koma).
# Admin bisa menulis artikel dan memberi/mencabut izin menulis akun lain.
ADMIN_EMAILS=
