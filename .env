ST_BLOG_DB_TURSO_DATABASE_URL=file:local.db
ST_BLOG_DB_TURSO_AUTH_TOKEN=

SITE_URL=http://localhost:4321

ADMIN_EMAILS=soteenstudio@gmail.com

# Cloudflare Turnstile. Kunci di bawah adalah kunci UJI resmi Cloudflare (selalu lolos), hanya untuk lokal.
# Untuk produksi, buat widget di dash.cloudflare.com > Turnstile, lalu isi kunci asli di Vercel.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Opsional: domain email tambahan yang ditolak saat daftar, dipisah koma.
# BLOCKED_EMAIL_DOMAINS=
