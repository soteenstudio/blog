---
import { categoryLabel } from "@/lib/categories";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import Avatar from "@/components/Avatar.astro";
import Comments from "@/components/Comments.astro";
import LikeButton from "@/components/LikeButton.astro";
import ShareButton from "@/components/ShareButton.astro";
import { locales } from "@/data/copy/index";
import { siteConfig } from "@/data/site";
import { listComments } from "@/lib/comments";
import { formatDate } from "@/lib/format";
import { hasLiked } from "@/lib/likes";
import { renderMarkdown } from "@/lib/markdown";
import { getPostBySlug, localize } from "@/lib/posts";
import { reveal } from "@/lib/reveal";

const copy = Astro.locals.copy;
const to = Astro.locals.href;
const locale = Astro.locals.locale;
const user = Astro.locals.user;
const post = await getPostBySlug(Astro.params.slug ?? "");

// Draf hanya boleh dilihat admin dan penulisnya (untuk pratinjau).
const canPreviewDraft = !!user && (user.role === "admin" || user.id === post?.authorId);
if (!post || (post.status !== "published" && !canPreviewDraft)) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const text = localize(post, locale);
const shownLangLabel = locales.find((l) => l.code === text.shownLang)!.label;

const [comments, liked] = await Promise.all([
  listComments(post.id, siteConfig.commentsLimit),
  user ? hasLiked(post.id, user.id) : Promise.resolve(false),
]);

const html = renderMarkdown(text.content);
const barePath = Astro.locals.path.split("?")[0];
const loginHref = to(`/login?next=${encodeURIComponent(barePath)}`);
const shareUrl = new URL(to(barePath), Astro.site).href;
const isDraft = post.status !== "published";
---

<BaseLayout title={text.title} description={text.excerpt || undefined} ogType="article">
  <div
    data-reading-progress
    role="progressbar"
    aria-label={copy.post.progress}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1"
  >
    <div data-reading-bar class="h-full w-full origin-left bg-brand" style="transform: scaleX(0)"></div>
  </div>

  <article class="mx-auto max-w-3xl px-5 pb-20 pt-12 sm:px-8 sm:pt-16">
    {
      isDraft && (
        <p class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
          {copy.post.draftNotice}
        </p>
      )
    }

    <a
      href={to("/")}
      {...reveal(0)}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
    >
      <Icon name="arrow-left" />
      {copy.post.backToList}
    </a>

    <div data-article-body>
      <header class="mt-8" lang={text.shownLang} {...reveal(80)}>
        <a href={to(`/?kategori=${encodeURIComponent(post.category)}`)} class="badge hover:bg-accent">
          {categoryLabel(post.category, locale)}
        </a>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-balance sm:text-5xl">
          {text.title}
        </h1>
        {text.excerpt && <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{text.excerpt}</p>}

        {
          !text.inRequestedLang && (
            <p class="mt-6 rounded-2xl border bg-secondary/50 px-4 py-3 text-sm text-muted-foreground">
              {copy.post.notTranslated(shownLangLabel)}
            </p>
          )
        }

        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 border-y py-4 text-sm text-muted-foreground">
          {
            post.authorId ? (
              <a href={to(`/u/${post.authorId}`)} class="group inline-flex items-center gap-3">
                <Avatar id={post.authorId} name={post.authorName} version={post.authorAvatarVersion} class="size-10 text-sm" tone="primary" />
                <span class="leading-tight">
                  <span class="block font-medium text-foreground group-hover:underline">{post.authorName}</span>
                  {post.authorProfession && <span class="block text-xs">{post.authorProfession}</span>}
                </span>
              </a>
            ) : (
              <span class="inline-flex items-center gap-3">
                <Avatar name={post.authorName} class="size-10 text-sm" tone="primary" />
                <span class="font-medium text-foreground">{post.authorName}</span>
              </span>
            )
          }
          <time datetime={post.publishedAt ?? undefined}>{formatDate(post.publishedAt ?? post.createdAt, locale)}</time>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="clock" class="size-3.5" />
            {copy.list.minutes(text.readingMinutes)}
          </span>
        </div>
      </header>

      <div class="prose-blog mt-10" lang={text.shownLang} set:html={html} />
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-3 border-t pt-6">
      <LikeButton postId={post.id} count={post.likeCount} liked={liked} loginHref={user ? null : loginHref} />
      <a
        href="#komentar"
        class="inline-flex h-10 items-center gap-2 rounded-full border px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        <Icon name="message" />
        {post.commentCount}
      </a>
      {!isDraft && <ShareButton url={shareUrl} title={text.title} />}
    </div>

    <div class="mt-14 scroll-mt-24">
      {
        isDraft ? null : (
          <Comments postId={post.id} comments={comments} total={post.commentCount} user={user} loginHref={loginHref} />
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  // Progres membaca: dari awal judul sampai akhir isi artikel (komentar tidak dihitung).
  const wrap = document.querySelector<HTMLElement>("[data-reading-progress]");
  const bar = document.querySelector<HTMLElement>("[data-reading-bar]");
  const body = document.querySelector<HTMLElement>("[data-article-body]");

  if (wrap && bar && body) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = body.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const raw = scrollable > 0 ? -rect.top / scrollable : rect.bottom <= window.innerHeight ? 1 : 0;
      const progress = Math.min(1, Math.max(0, raw));
      bar.style.transform = `scaleX(${progress})`;
      wrap.setAttribute("aria-valuenow", String(Math.round(progress * 100)));
    };

    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>
