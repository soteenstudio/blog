---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { formatDate } from "@/lib/format";
import { listForDashboard } from "@/lib/posts";

const copy = Astro.locals.copy;
const locale = Astro.locals.locale;

const user = Astro.locals.user!; // dijamin punya izin menulis oleh middleware
const isAdmin = user.role === "admin";
const posts = await listForDashboard(user);
const confirmMessage = JSON.stringify(copy.dashboard.deleteConfirm);
---

<BaseLayout title={copy.dashboard.title}>
  <section class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{copy.dashboard.title}</h1>
        <p class="mt-3 text-muted-foreground">
          {isAdmin ? copy.dashboard.descriptionAdmin : copy.dashboard.description}
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          isAdmin && (
            <a href="/dashboard/users" class="btn btn-outline">
              {copy.dashboard.manageUsers}
            </a>
          )
        }
        <a href="/dashboard/posts/new" class="btn btn-brand">
          <Icon name="plus" />
          {copy.dashboard.newPost}
        </a>
      </div>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-10 rounded-3xl border border-dashed p-10 text-center text-muted-foreground">
          {copy.dashboard.empty}
        </p>
      ) : (
        <div class="mt-10 overflow-x-auto rounded-3xl border">
          <table class="w-full min-w-[44rem] text-left text-sm">
            <thead class="border-b bg-secondary/50 text-xs text-muted-foreground">
              <tr>
                <th class="px-5 py-3 font-medium">{copy.dashboard.colTitle}</th>
                {isAdmin && <th class="px-5 py-3 font-medium">{copy.dashboard.colAuthor}</th>}
                <th class="px-5 py-3 font-medium">{copy.dashboard.colStatus}</th>
                <th class="px-5 py-3 font-medium">{copy.dashboard.colStats}</th>
                <th class="px-5 py-3 font-medium">{copy.dashboard.colUpdated}</th>
                <th class="px-5 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {posts.map((post) => (
                <tr class="align-top">
                  <td class="max-w-xs px-5 py-4">
                    <p class="font-medium">{post.title}</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                      {post.category} · /posts/{post.slug}
                    </p>
                  </td>
                  {isAdmin && <td class="px-5 py-4 text-muted-foreground">{post.authorName}</td>}
                  <td class="px-5 py-4">
                    <span class:list={["badge", post.status === "published" ? "badge-live" : "badge-draft"]}>
                      {post.status === "published" ? copy.dashboard.published : copy.dashboard.draft}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-muted-foreground">
                    <span class="inline-flex items-center gap-1">
                      <Icon name="heart" class="size-3.5" /> {post.likeCount}
                    </span>
                    <span class="ml-3 inline-flex items-center gap-1">
                      <Icon name="message" class="size-3.5" /> {post.commentCount}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-muted-foreground">{formatDate(post.updatedAt, locale)}</td>
                  <td class="px-5 py-4">
                    <div class="flex items-center justify-end gap-2">
                      <a href={`/posts/${post.slug}`} class="btn btn-ghost btn-sm">
                        {copy.dashboard.view}
                      </a>
                      <a href={`/dashboard/posts/${post.id}`} class="btn btn-outline btn-sm">
                        <Icon name="pencil" />
                        {copy.dashboard.edit}
                      </a>
                      <form
                        method="post"
                        action={`/dashboard/posts/${post.id}`}
                        onsubmit={`return confirm(${confirmMessage})`}
                      >
                        <input type="hidden" name="_action" value="delete" />
                        <button type="submit" class="btn btn-danger btn-sm">
                          <Icon name="trash" />
                          {copy.dashboard.delete}
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</BaseLayout>
