---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostForm from "@/components/PostForm.astro";
import { DEFAULT_CATEGORY_ID } from "@/lib/categories";
import { createPost } from "@/lib/posts";
import type { PostInput } from "@/lib/posts";
import { parsePostForm } from "@/lib/validation";

const to = Astro.locals.href;

const copy = Astro.locals.copy;

const user = Astro.locals.user!; // dijamin punya izin menulis oleh middleware

let values: PostInput = {
  lang: Astro.locals.locale,
  altTitle: "",
  altExcerpt: "",
  altContent: "",
  title: "",
  slug: "",
  excerpt: "",
  content: "",
  category: DEFAULT_CATEGORY_ID,
  status: "draft",
};
let error: string | null = null;

if (Astro.request.method === "POST") {
  const parsed = parsePostForm(await Astro.request.formData(), copy);
  values = parsed.values;
  error = parsed.error;

  if (!error) {
    await createPost(values, { id: user.id, name: user.name });
    return Astro.redirect(to("/dashboard"), 303);
  }
}

---

<BaseLayout title={copy.dashboard.newPost}>
  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{copy.dashboard.newPost}</h1>
    <div class="mt-10">
      <PostForm values={values} error={error} action="/dashboard/posts/new" />
    </div>
  </section>
</BaseLayout>
