---
import BaseLayout from "@/layouts/BaseLayout.astro";

const copy = Astro.locals.copy;
const to = Astro.locals.href;
const user = Astro.locals.user;
const reason = Astro.locals.forbidden ?? "author";

Astro.response.status = 403;
---

<BaseLayout title={copy.forbidden.title}>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-5 py-28 sm:px-8">
    <p class="font-display text-6xl font-semibold tracking-tight text-brand">403</p>
    <h1 class="mt-6 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{copy.forbidden.title}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{reason === "admin" ? copy.forbidden.admin : copy.forbidden.author}</p>
    {user && <p class="mt-3 text-sm text-muted-foreground">{copy.forbidden.signedInAs(user.email)}</p>}
    {
      import.meta.env.DEV && user && (
        <p class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
          {copy.forbidden.devHint(user.email)}
        </p>
      )
    }
    <a href={to("/")} class="btn btn-default btn-lg mt-10">{copy.forbidden.cta}</a>
  </section>
</BaseLayout>
