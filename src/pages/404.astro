---
import BaseLayout from "@/layouts/BaseLayout.astro";

const copy = Astro.locals.copy;
const to = Astro.locals.href;
---

<BaseLayout title={copy.notFound.title}>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-5 py-28 sm:px-8">
    <p class="font-display text-6xl font-semibold tracking-tight text-brand">404</p>
    <h1 class="mt-6 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{copy.notFound.title}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{copy.notFound.description}</p>
    <a href={to("/")} class="btn btn-default btn-lg mt-10">{copy.notFound.cta}</a>
  </section>
</BaseLayout>
