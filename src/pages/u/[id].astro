---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Avatar from "@/components/Avatar.astro";
import FollowButton from "@/components/FollowButton.astro";
import PostCard from "@/components/PostCard.astro";
import { isFollowing } from "@/lib/follows";
import { formatDate } from "@/lib/format";
import { listPublishedByAuthor } from "@/lib/posts";
import { getPublicProfile } from "@/lib/profile";
import { reveal } from "@/lib/reveal";

const copy = Astro.locals.copy;
const to = Astro.locals.href;
const locale = Astro.locals.locale;
const viewer = Astro.locals.user;

const profile = await getPublicProfile(Astro.params.id ?? "");
if (!profile) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const isSelf = viewer?.id === profile.id;
const [posts, following] = await Promise.all([
  listPublishedByAuthor(profile.id),
  viewer && !isSelf ? isFollowing(viewer.id, profile.id) : Promise.resolve(false),
]);
const loginHref = to(`/login?next=${encodeURIComponent(Astro.locals.path.split("?")[0])}`);
const countTemplate = copy.people.followerCount(0).replace("0", "{n}");
---

<BaseLayout title={profile.name}>
  <section class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="bg-dots pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_55%)]"
    >
    </div>
    <div class="mx-auto max-w-7xl px-5 pb-20 pt-16 sm:px-8 sm:pt-24">
      <div {...reveal(0)} class="flex flex-wrap items-center gap-6">
        <Avatar id={profile.id} name={profile.name} version={profile.avatarVersion} class="size-28 text-4xl" tone="primary" />
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{profile.name}</h1>
          <p class="mt-1 text-lg text-muted-foreground">{profile.profession ?? copy.people.noProfession}</p>
          <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
            <span data-follower-count data-template={countTemplate}>{copy.people.followerCount(profile.followerCount)}</span>
            <span>{copy.people.joined} {formatDate(profile.createdAt, locale)}</span>
          </p>
        </div>
        <div class="sm:ml-auto">
          {
            isSelf ? (
              <a href={to("/profile")} class="btn btn-outline">
                {copy.people.editProfile}
              </a>
            ) : (
              <FollowButton userId={profile.id} following={following} loginHref={viewer ? null : loginHref} />
            )
          }
        </div>
      </div>

      <h2 class="mt-16 font-display text-2xl font-semibold tracking-tight">{copy.people.posts}</h2>
      {
        posts.length === 0 ? (
          <p class="mt-6 rounded-3xl border border-dashed p-10 text-center text-muted-foreground">{copy.people.noPosts}</p>
        ) : (
          <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, index) => (
              <PostCard post={post} delay={(index % 3) * 90} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
