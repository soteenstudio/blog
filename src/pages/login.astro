---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { authenticate, createSession, safeNextPath } from "@/lib/auth";
import { stripLocale } from "@/lib/i18n";
import { clientKey, rateLimit } from "@/lib/rate-limit";
import { parseLoginForm } from "@/lib/validation";

const copy = Astro.locals.copy;
const to = Astro.locals.href;

// ?next= disimpan tanpa awalan bahasa; awalan ditambah saat mengarahkan.
const next = stripLocale(safeNextPath(Astro.url.searchParams.get("next")));
if (Astro.locals.user) return Astro.redirect(to(next));

let error: string | null = null;
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const input = parseLoginForm(form);
  email = input.email;

  const ip = clientKey(() => Astro.clientAddress);
  if (!rateLimit(`login:${ip}`, 10, 15 * 60_000)) {
    error = copy.errors.tooManyRequests;
  } else {
    const userId = input.email && input.password ? await authenticate(input.email, input.password) : null;
    if (!userId) {
      error = copy.errors.invalidCredentials;
    } else {
      await createSession(Astro.cookies, userId);
      return Astro.redirect(to(next), 303);
    }
  }
}

const registerHref = to(next === "/" ? "/register" : `/register?next=${encodeURIComponent(next)}`);
---

<BaseLayout title={copy.auth.loginTitle}>
  <section class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="bg-dots pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_65%)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-32 -top-32 -z-10 size-[28rem] rounded-full bg-brand/10 blur-3xl"
    >
    </div>

    <div class="mx-auto max-w-md px-5 py-20 sm:py-28">
      <div class="rounded-3xl border bg-background p-8 shadow-xl shadow-brand/5">
        <h1 class="font-display text-3xl font-semibold tracking-tight">{copy.auth.loginTitle}</h1>
        <p class="mt-2 text-muted-foreground">{copy.auth.loginDescription}</p>

        <form method="post" action={`/login?next=${encodeURIComponent(next)}`} class="mt-8 space-y-5">
          {
            error && (
              <p
                role="alert"
                class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300"
              >
                {error}
              </p>
            )
          }
          <div>
            <label for="email" class="label">{copy.auth.email}</label>
            <input id="email" name="email" type="email" required autocomplete="email" value={email} class="field" />
          </div>
          <div>
            <label for="password" class="label">{copy.auth.password}</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="field"
            />
          </div>
          <button type="submit" class="btn btn-brand w-full">{copy.auth.loginSubmit}</button>
        </form>

        <p class="mt-6 text-center text-sm text-muted-foreground">
          {copy.auth.noAccount}
          <a href={registerHref} class="font-medium text-foreground underline-offset-4 hover:underline">
            {copy.nav.register}
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
