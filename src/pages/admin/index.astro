---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { copy } from "@/data/copy";
import { formatDate } from "@/lib/format";
import { listAllForAdmin } from "@/lib/posts";

const to = Astro.locals.href;

const posts = await listAllForAdmin();
const confirmMessage = JSON.stringify(copy.admin.deleteConfirm);
---

<BaseLayout title={copy.admin.title}>
  <section class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{copy.admin.title}</h1>
        <p class="mt-3 text-muted-foreground">{copy.admin.description}</p>
      </div>
      <a href={to("/admin/posts/new")} class="btn btn-brand">
        <Icon name="plus" />
        {copy.admin.newPost}
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-10 rounded-3xl border border-dashed p-10 text-center text-muted-foreground">{copy.admin.empty}</p>
      ) : (
        <div class="mt-10 overflow-x-auto rounded-3xl border">
          <table class="w-full min-w-[40rem] text-left text-sm">
            <thead class="border-b bg-secondary/50 text-xs text-muted-foreground">
              <tr>
                <th class="px-5 py-3 font-medium">{copy.admin.colTitle}</th>
                <th class="px-5 py-3 font-medium">{copy.admin.colStatus}</th>
                <th class="px-5 py-3 font-medium">{copy.admin.colStats}</th>
                <th class="px-5 py-3 font-medium">{copy.admin.colUpdated}</th>
                <th class="px-5 py-3" />
              </tr>
            </thead>
            <tbody class="divide-y">
              {posts.map((post) => (
                <tr class="align-top">
                  <td class="max-w-xs px-5 py-4">
                    <p class="font-medium">{post.title}</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                      {post.category} · /posts/{post.slug}
                    </p>
                  </td>
                  <td class="px-5 py-4">
                    <span class:list={["badge", post.status === "published" ? "badge-live" : "badge-draft"]}>
                      {post.status === "published" ? copy.admin.published : copy.admin.draft}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-muted-foreground">
                    <span class="inline-flex items-center gap-1">
                      <Icon name="heart" class="size-3.5" /> {post.likeCount}
                    </span>
                    <span class="ml-3 inline-flex items-center gap-1">
                      <Icon name="message" class="size-3.5" /> {post.commentCount}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-muted-foreground">{formatDate(post.updatedAt)}</td>
                  <td class="px-5 py-4">
                    <div class="flex items-center justify-end gap-2">
                      <a href={to(`/posts/${post.slug}`)} class="btn btn-ghost btn-sm">
                        {copy.admin.view}
                      </a>
                      <a href={to(`/admin/posts/${post.id}`)} class="btn btn-outline btn-sm">
                        <Icon name="pencil" />
                        {copy.admin.edit}
                      </a>
                      <form method="post" action={`/admin/posts/${post.id}`} onsubmit={`return confirm(${confirmMessage})`}>
                        <input type="hidden" name="_action" value="delete" />
                        <button type="submit" class="btn btn-danger btn-sm">
                          <Icon name="trash" />
                          {copy.admin.delete}
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</BaseLayout>
