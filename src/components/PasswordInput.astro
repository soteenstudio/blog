---
/**
 * Kolom kata sandi dengan tombol lihat/sembunyikan. Dengan `meter`, di bawahnya tampil pengukur
 * kekuatan (bar, label, perkiraan waktu tebak, dan saran). Penolakan sesungguhnya tetap di server.
 */
interface Props {
  id?: string;
  name?: string;
  autocomplete: "current-password" | "new-password";
  meter?: boolean;
  /** id kolom nama dan email, supaya kata sandi yang memuat nama/email ikut dinilai lemah. */
  nameId?: string;
  emailId?: string;
  minlength?: number;
  maxlength?: number;
}

const { id = "password", name = "password", autocomplete, meter = false, nameId, emailId, minlength, maxlength } = Astro.props;
const m = Astro.locals.copy.passwordMeter;

const config = {
  levels: m.levels,
  hints: m.hints,
  tooWeak: m.tooWeak,
  nameId,
  emailId,
};
---

<div>
  <div class="relative">
    <input
      id={id}
      name={name}
      type="password"
      required
      minlength={minlength}
      maxlength={maxlength}
      autocomplete={autocomplete}
      class="field pr-12"
      aria-describedby={meter ? `${id}-meter` : undefined}
      data-pw-input
    />
    <button
      type="button"
      data-pw-toggle
      data-show={m.show}
      data-hide={m.hide}
      aria-label={m.show}
      aria-pressed="false"
      title={m.show}
      class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-xl text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
    >
      <svg data-eye viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg data-eye-off viewBox="0 0 24 24" class="hidden size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17.94 17.94A10.9 10.9 0 0 1 12 19c-6.5 0-10-7-10-7a18.7 18.7 0 0 1 5.06-5.94"></path>
        <path d="M9.9 4.24A10.4 10.4 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19"></path>
        <path d="M1 1l22 22"></path>
        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
      </svg>
    </button>
  </div>

  {
    meter && (
      <div id={`${id}-meter`} data-pw-meter data-level="-1" data-config={JSON.stringify(config)} class="pw-meter mt-3">
        <div class="flex gap-1.5" aria-hidden="true">
          <span class="seg"></span>
          <span class="seg"></span>
          <span class="seg"></span>
          <span class="seg"></span>
          <span class="seg"></span>
        </div>
        <div class="mt-2 text-xs">
          <p aria-live="polite">
            <span class="text-muted-foreground">{m.label}:</span> <strong data-pw-label class="font-semibold">—</strong>
          </p>
        </div>
        <ul data-pw-hints class="mt-1.5 list-disc space-y-0.5 pl-4 text-xs text-muted-foreground" />
        <p class="mt-1.5 text-xs text-muted-foreground">{m.note}</p>
      </div>
    )
  }
</div>

<style>
  .seg {
    height: 0.375rem;
    flex: 1;
    border-radius: 9999px;
    background: hsl(var(--muted));
    transition: background-color 0.2s;
  }
  .pw-meter[data-level="0"] .seg:nth-child(-n + 1) { background: #ef4444; }
  .pw-meter[data-level="1"] .seg:nth-child(-n + 2) { background: #f97316; }
  .pw-meter[data-level="2"] .seg:nth-child(-n + 3) { background: #eab308; }
  .pw-meter[data-level="3"] .seg:nth-child(-n + 4) { background: #22c55e; }
  .pw-meter[data-level="4"] .seg:nth-child(-n + 5) { background: #16a34a; }
  .pw-meter[data-level="0"] [data-pw-label] { color: #ef4444; }
  .pw-meter[data-level="1"] [data-pw-label] { color: #f97316; }
  .pw-meter[data-level="2"] [data-pw-label] { color: #ca8a04; }
  .pw-meter[data-level="3"] [data-pw-label] { color: #16a34a; }
  .pw-meter[data-level="4"] [data-pw-label] { color: #15803d; }
</style>

<script>
  import { evaluatePassword, MIN_SCORE } from "../lib/password-strength";
  import type { Hint } from "../lib/password-strength";

  interface Config {
    levels: string[];
    hints: Record<Hint, string>;
    tooWeak: string;
    nameId?: string;
    emailId?: string;
  }

  // Tombol lihat/sembunyikan
  document.querySelectorAll<HTMLButtonElement>("[data-pw-toggle]").forEach((button) => {
    const input = button.parentElement?.querySelector<HTMLInputElement>("[data-pw-input]");
    if (!input) return;
    button.addEventListener("click", () => {
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      const text = (show ? button.dataset.hide : button.dataset.show) ?? "";
      button.setAttribute("aria-pressed", String(show));
      button.setAttribute("aria-label", text);
      button.title = text;
      button.querySelector("[data-eye]")?.classList.toggle("hidden", show);
      button.querySelector("[data-eye-off]")?.classList.toggle("hidden", !show);
    });
  });

  // Pengukur kekuatan
  document.querySelectorAll<HTMLElement>("[data-pw-meter]").forEach((meter) => {
    const input = meter.parentElement?.querySelector<HTMLInputElement>("[data-pw-input]");
    if (!input) return;
    const config = JSON.parse(meter.dataset.config ?? "{}") as Config;
    const label = meter.querySelector<HTMLElement>("[data-pw-label]")!;
    const hintList = meter.querySelector<HTMLElement>("[data-pw-hints]")!;
    const nameField = config.nameId ? document.getElementById(config.nameId) as HTMLInputElement | null : null;
    const emailField = config.emailId ? document.getElementById(config.emailId) as HTMLInputElement | null : null;

    const update = () => {
      const value = input.value;
      if (!value) {
        meter.dataset.level = "-1";
        label.textContent = "—";
        hintList.replaceChildren();
        input.setCustomValidity("");
        return;
      }

      const result = evaluatePassword(value, { name: nameField?.value, email: emailField?.value });
      meter.dataset.level = String(result.score);
      label.textContent = config.levels[result.score] ?? "";

      // Maksimal tiga saran supaya tidak terasa seperti omelan.
      const items = result.hints.slice(0, 3).map((hint) => {
        const li = document.createElement("li");
        li.textContent = config.hints[hint] ?? "";
        return li;
      });
      hintList.replaceChildren(...items);

      input.setCustomValidity(result.score < MIN_SCORE ? config.tooWeak : "");
    };

    input.addEventListener("input", update);
    nameField?.addEventListener("input", update);
    emailField?.addEventListener("input", update);
    update();
  });
</script>
