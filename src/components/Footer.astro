---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { legalLinks, siteConfig, socialLinks } from "@/data/site";
import { reveal } from "@/lib/reveal";

const copy = Astro.locals.copy;
---

<footer class="border-t bg-secondary/40">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8" {...reveal(0, "fade")}>
    <div>
      <div>
        <Logo />
        <p class="mt-5 max-w-sm leading-relaxed text-muted-foreground">{copy.site.tagline}</p>

        <ul class="mt-8 flex gap-2">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  aria-label={social.label}
                  class="grid size-10 place-items-center rounded-full border bg-background text-muted-foreground transition-all hover:-translate-y-0.5 hover:border-brand/40 hover:text-brand"
                >
                  <Icon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t pt-8 text-xs text-muted-foreground lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="space-y-1">
        <p>© {new Date().getFullYear()} {siteConfig.name}. {copy.footer.rights}</p>
        <p>{copy.footer.legalNotice}</p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-foreground">
                {copy.footer.legal[link.id]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
