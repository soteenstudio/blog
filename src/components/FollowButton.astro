---
import Icon from "./Icon.astro";

interface Props {
  userId: string;
  following: boolean;
  /** Null bila pengunjung sudah masuk; selain itu alamat login. */
  loginHref: string | null;
}
const { userId, following, loginHref } = Astro.props;
const copy = Astro.locals.copy;
---

{
  loginHref ? (
    <a href={loginHref} class="btn btn-outline">
      <Icon name="user-plus" />
      {copy.people.loginToFollow}
    </a>
  ) : (
    <button
      type="button"
      data-follow-button
      data-user-id={userId}
      data-label-follow={copy.people.follow}
      data-label-following={copy.people.following}
      aria-pressed={following}
      class="btn btn-outline [&[aria-pressed=true]]:border-brand/40 [&[aria-pressed=true]]:bg-brand/10 [&[aria-pressed=true]]:text-brand"
    >
      <Icon name="user-plus" />
      <span data-follow-label>{following ? copy.people.following : copy.people.follow}</span>
    </button>
  )
}

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-follow-button]");

  if (button) {
    button.addEventListener("click", async () => {
      if (button.disabled) return;
      button.disabled = true;
      try {
        const res = await fetch("/api/follow", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: button.dataset.userId }),
        });
        if (res.status === 401) {
          window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
          return;
        }
        if (!res.ok) return;
        const data = (await res.json()) as { following: boolean; followers: number };
        button.setAttribute("aria-pressed", String(data.following));
        const label = button.querySelector("[data-follow-label]");
        if (label) {
          label.textContent = data.following ? button.dataset.labelFollowing! : button.dataset.labelFollow!;
        }
        document.querySelectorAll<HTMLElement>("[data-follower-count]").forEach((el) => {
          const template = el.dataset.template ?? "{n}";
          el.textContent = template.replace("{n}", String(data.followers));
        });
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
