---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Icon from "./Icon.astro";
import Avatar from "./Avatar.astro";
import type { SessionUser } from "@/lib/auth";

const copy = Astro.locals.copy;
const to = Astro.locals.href;

interface Props {
  user: SessionUser | null;
  pathname: string;
}
const { user, pathname } = Astro.props;
const loginHref = to(`/login?next=${encodeURIComponent(pathname)}`);
const path = pathname.split("?")[0];

// Pengunjung biasa tidak melihat menu apa pun; tautan menulis dan izin hanya muncul untuk yang berhak.
const links = [
  { href: "/dashboard/posts/new", label: copy.nav.write, show: !!user?.canPost },
  { href: "/dashboard/users", label: copy.nav.permissions, show: user?.role === "admin" },
].filter((l) => l.show);
---

<header
  data-navbar
  class="sticky top-0 z-40 w-full border-b border-transparent bg-background/80 backdrop-blur-md transition-colors data-[scrolled=true]:border-border"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
    <Logo />

    {links.length > 0 && (
    <nav aria-label={copy.nav.ariaMain} class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={to(link.href)}
            aria-current={path === link.href ? "page" : undefined}
            class="rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    )}

    <div class="flex items-center gap-2">
      <LanguageSwitcher pathname={pathname} />
      <ThemeToggle />

      {
        user ? (
          <details data-dropdown class="group relative">
            <summary
              aria-label={copy.nav.account}
              class="flex h-9 cursor-pointer list-none items-center gap-2 rounded-full border pl-1 pr-3 text-sm font-medium outline-none transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring group-open:bg-accent [&::-webkit-details-marker]:hidden"
            >
              <Avatar id={user.id} name={user.name} version={user.avatarVersion} class="size-7 text-xs" tone="primary" />
              <span class="hidden max-w-[8rem] truncate sm:inline">{user.name}</span>
              <Icon name="chevron-down" class="size-3.5 transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <div class="absolute right-0 mt-2 w-56 rounded-2xl border bg-popover p-1.5 text-popover-foreground shadow-lg">
              <p class="truncate px-3 py-2 text-xs text-muted-foreground">{user.email}</p>
              {user.canPost && (
                <>
                  <a
                    href={to("/dashboard")}
                    class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors hover:bg-accent"
                  >
                    <Icon name="pencil" />
                    {copy.nav.dashboard}
                  </a>
                  <a
                    href={to("/dashboard/posts/new")}
                    class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors hover:bg-accent"
                  >
                    <Icon name="plus" />
                    {copy.nav.write}
                  </a>
                </>
              )}
              {user.role === "admin" && (
                <a
                  href={to("/dashboard/users")}
                  class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors hover:bg-accent"
                >
                  <Icon name="check" />
                  {copy.nav.permissions}
                </a>
              )}
              <a
                href={to("/profile")}
                class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors hover:bg-accent"
              >
                <Icon name="user" />
                {copy.nav.profile}
              </a>
              <form method="post" action="/logout">
                <button
                  type="submit"
                  class="flex w-full items-center gap-2 rounded-xl px-3 py-2.5 text-left text-sm font-medium transition-colors hover:bg-accent"
                >
                  <Icon name="log-out" />
                  {copy.nav.logout}
                </button>
              </form>
            </div>
          </details>
        ) : (
          <>
            <a href={loginHref} class="btn btn-outline btn-sm">
              {copy.nav.login}
            </a>
            <a href={to("/register")} class="btn btn-default btn-sm hidden sm:inline-flex">
              {copy.nav.register}
            </a>
          </>
        )
      }
    </div>
  </div>
</header>
