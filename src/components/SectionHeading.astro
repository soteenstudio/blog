---
import { reveal } from "@/lib/reveal";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  tag?: "h1" | "h2";
}
const { eyebrow, title, description, class: className = "", tag: Tag = "h2" } = Astro.props;
---

<div class:list={["max-w-2xl", className]} {...reveal()}>
  {
    eyebrow && (
      <p class="mb-4 flex items-center gap-2 text-sm font-medium text-brand">
        <span aria-hidden="true" class="h-px w-6 bg-brand" />
        {eyebrow}
      </p>
    )
  }
  <Tag class="font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-5xl">{title}</Tag>
  {description && <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{description}</p>}
</div>
