---
import { siteConfig } from "@/data/site";

interface Props {
  product?: string;
  class?: string;
}

const { product, class: className = "" } = Astro.props;
const to = Astro.locals.href;
const label = product ? `${siteConfig.name} ${product}` : `${siteConfig.name} ${siteConfig.blogLabel}`;
---

<a
  href={to("/")}
  aria-label={label}
  class:list={[
    "group inline-flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight",
    className,
  ]}
>
  <span
    aria-hidden="true"
    class="grid size-8 place-items-center rounded-lg bg-primary text-sm font-bold text-primary-foreground transition-transform duration-300 group-hover:-rotate-6"
  >
    S
  </span>
  SoTeen<span class="font-normal text-muted-foreground">Studio</span>
  {product && (
    <>
      <span aria-hidden="true" class="hidden h-5 w-px bg-border sm:block" />
      <span class="hidden text-base font-medium text-muted-foreground sm:block">
        {product}
      </span>
    </>
  )}
</a>